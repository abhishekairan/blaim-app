# Public origin for canonical / Open Graph / JSON-LD / sitemap URLs (no trailing slash)
SITE_URL=
# Google Tag Manager container. Leave empty to ship no analytics.
# The original page used GTM-5FKQFC7Z (World Brain Mapping Foundation container).
GTM_ID=
PORT=3000

# --- SMTP (outgoing mail). Leave SMTP_HOST empty to disable sending (mail is logged instead).
# Port 587 = STARTTLS (TLS is required unless SMTP_REQUIRE_TLS=false); 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "BLAIM 2027 <abstracts@example.org>". Defaults to SMTP_USER. Must be allowed by your SMTP provider.
SMTP_FROM=

# --- Abstract submissions (/abstract-submission/)
# Conference office address that receives each new abstract. Empty = only the submitter is emailed.
ABSTRACT_NOTIFY_TO=
# Word limit (not yet confirmed by the committee).
ABSTRACT_MAX_WORDS=300
# Where submissions are stored, one JSON object per line. Must be on persistent disk.
ABSTRACT_STORE_PATH=data/abstracts.jsonl
# Set to true only behind a reverse proxy that sets X-Forwarded-For (used for rate limiting).
TRUST_PROXY=false
